+#pragma once
+#include "update_task_i.h"
+#define HYBRIDUS_PRESERVE_INFO "hybridus-ui-0.7-095e-preserve"
+static inline bool hybridus_preserve_package(UpdateTask* task) {
+    UpdateManifest* m = task->manifest;
+    return m->target == 7 &&
+           furi_string_equal(m->version, HYBRIDUS_PRESERVE_INFO) &&
+           !furi_string_empty(m->firmware_dfu_image) &&
+           furi_string_empty(m->radio_image) &&
+           furi_string_empty(m->resource_bundle) &&
+           furi_string_empty(m->splash_file) &&
+           !update_manifest_has_obdata(m);
+}
+
+// Reject malformed preserve requests instead of falling back to a wiping update.
+static inline bool hybridus_preserve_manifest_allowed(UpdateTask* task) {
+    return !furi_string_equal(task->manifest->version, HYBRIDUS_PRESERVE_INFO) ||
+           hybridus_preserve_package(task);
+}
